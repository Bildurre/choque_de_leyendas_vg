; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Choque de Leyendas"
run/main_scene="res://screens/main_menu/main_menu_desktop.tscn"
config/features=PackedStringArray("4.3")

[autoload]

TranslationLoader="*res://autoloads/translation_loader.gd"
CursorManager="*res://autoloads/cursor_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/theme/game_theme.tres"

[internationalization]

locale/locale_filter_mode=1
locale/locale_filter=PackedStringArray("en", "es")
locale/test="es"

[rendering]

renderer/rendering_method="gl_compatibility"
